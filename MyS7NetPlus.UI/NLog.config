<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="logs/nlog-internal.log">

  <variable name="logRoot" value="logs"/>

  <targets async="true">
    <!-- ========== Target1：WinForm业务日志（S7通讯、UI等业务） ========== -->
    <target xsi:type="File" name="targetWinForm"
            fileName="${logRoot}/winform-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=ToString}"
            archiveEvery="Day"
            maxArchiveFiles="30"
            encoding="utf-8"/>

    <!-- ========== Target2：WebApi / Kestrel ASP.NET日志 ========== -->
    <target xsi:type="File" name="targetWebApi"
            fileName="${logRoot}/webapi-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${aspnet-request-method}|${aspnet-request-url}|${message} ${exception:format=ToString}"
            archiveEvery="Day"
            maxArchiveFiles="30"
            encoding="utf-8"/>

    <!-- 控制台调试：全部日志都输出控制台，方便开发看 -->
    <target xsi:type="Console" name="targetConsole"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=ToString}"/>
  </targets>

  <rules>
    <logger name="WinFormLogger" minlevel="Info" writeTo="targetWinForm" final="false"/>
    <logger name="WebApiLogger" minlevel="Info" writeTo="targetWebApi" final="false"/>
    <logger name="*" minlevel="Info" writeTo="targetConsole" final="false"/>
    <!-- 1) WinForm自己业务代码日志（排除Microsoft.AspNetCore.*）写入winform日志 + 控制台 -->
    <!-- <logger name="MyS7NetPlus.*" minlevel="Info" writeTo="targetWinForm,targetConsole" final="false"/>-->

    <!-- 2) ASP.NET / Kestrel / Microsoft.AspNetCore.* 全部路由到webapi日志 + 控制台 -->
    <!-- <logger name="Microsoft.AspNetCore.*" minlevel="Info" writeTo="targetWebApi,targetConsole" final="false"/> -->
    <!-- <logger name="Microsoft.Hosting.*" minlevel="Info" writeTo="targetWebApi,targetConsole" final="false"/> -->

    <!-- 兜底：其它第三方库日志，如果你不想看到可以改成Off；调试时Info -->
    <!-- <logger name="*" minlevel="Warn" writeTo="targetConsole"/> -->
  </rules>
</nlog>
